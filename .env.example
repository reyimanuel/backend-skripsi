# Port to run the application
PORT=8080 
IS_PRODUCTION=false
# Set to true for production environment
# Set to false for development environment

# Database username. Default is 'postgres'
DB_USER=postgres 
# Database password.
DB_PASS=fill-in-your-password 
# This is the name of the database.
DB_NAME=db-name 
 # Database host. using localhost
DB_HOST=127.0.0.1
# Database port. Default is 5432 for PostgreSQL
DB_PORT=5432 
# Time zone for the database connection.
DB_TIME_ZONE=Asia/Jakarta 

# Allowed origin for CORS. Set to '*' to allow all origins.
ALLOW_ORIGIN=* 

# Base URL of the application
BASE_URL=http://localhost:8080

# Access token expiration time in seconds.
ACCESS_TOKEN_LIFE_TIME=3600 
# Refresh token expiration time in seconds.
REFRESH_TOKEN_LIFE_TIME=86400 

# Rate limiter: global requests per second (set <=0 to disable)
RATE_LIMIT_RPS=10
# Rate limiter: burst size for the token bucket
RATE_LIMIT_BURST=20

# SMTP configuration for sending emails
# SMTP server host
SMTP_HOST=smtp.gmail.com
# SMTP server port
SMTP_PORT=587
# SMTP username (your email address)
SMTP_USER=your-email@gmail.com
# SMTP password (use an app password if using Gmail with 2FA)
SMTP_PASS=your-app-password

# Path to the private key file for JWT signing
PRIVATE_KEY=./keys/your_private_key.pem

# Path to the public key file for JWT verification
PUBLIC_KEY=./keys/your_public_key.pem

# ToDo: Change to frontend URL
FRONTEND_URL=http://localhost:3000

ENABLE_SWAGGER=true
SWAGGER_USER=admin
SWAGGER_PASSWORD=admin
SWAGGER_SESSION_SECRET=change-this-secret
SWAGGER_SESSION_TTL_MIN=60

# Maximum upload size (in MB) for multipart/form-data
UPLOAD_MAX_SIZE_MB=10

# Token
LOGIN_TOKEN_LENGTH=4
VERIFICATION_CODE_LENGTH=6


EMAIL_PROVIDER=aws_ses / sendgrid / smtp (choose one)

# AWS SES Configuration
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_SES_SENDER_EMAIL=noreply@yourdomain.com

# SendGrid Configuration 
SENDGRID_API_KEY=your_api_key
SENDGRID_SENDER_EMAIL=your_sender_email
SENDGRID_SENDER_NAME=E-Voting UNITY